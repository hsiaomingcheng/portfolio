---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Keep a page out of search results (used by the 404 page). */
  noindex?: boolean;
  /** Open Graph type: "website" for the home page, "article" for case studies. */
  ogType?: 'website' | 'article';
  /** Absolute or site-relative path to a 1200×630 share image. [TODO: add once the domain is known] */
  ogImage?: string;
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  noindex = false,
  ogType = 'website',
  ogImage,
} = Astro.props;
const imageUrl = ogImage ? new URL(ogImage, Astro.site ?? site.url).href : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);

// Where the chatbot backend lives (set in .env). Used by the wake-up ping below.
const chatbotApi = ((import.meta.env.PUBLIC_CHATBOT_API_URL as string | undefined) ?? '').replace(
  /\/$/,
  '',
);
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_NZ" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <!--
      Wake-up ping. Render's free tier sleeps when idle, so poke it as soon as any page
      loads; it is then awake by the time the visitor scrolls to the chat.
      Fire-and-forget: never awaited, never blocks rendering, errors swallowed.
      Sent once per browsing session. "no-cors" is enough to wake the server (we ignore the
      response), and it avoids a CORS error in the console on pages that don't use the chat.
    -->
    <script is:inline define:vars={{ chatbotApi }}>
      (function () {
        if (!chatbotApi) return;
        var alreadySent = false;
        try {
          alreadySent = sessionStorage.getItem('chatbot-wakeup') === '1';
          if (!alreadySent) sessionStorage.setItem('chatbot-wakeup', '1');
        } catch (e) {
          // sessionStorage can throw in some privacy modes. Ping anyway.
        }
        if (alreadySent) return;
        fetch(chatbotApi + '/api/health', { mode: 'no-cors' }).catch(function () {});
      })();
    </script>
  </head>
  <body id="top" class="flex min-h-screen flex-col">
    <!-- Hidden until focused, so keyboard users can skip the nav. -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2.5 focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
