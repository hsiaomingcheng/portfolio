---
import { site } from '../data/site';

// On the home page, links jump within the page ("#work").
// On other pages (e.g. a case study) they go back to the home page ("/#work").
const isHome = Astro.url.pathname === '/';
const prefix = isHome ? '' : '/';

const links = [
  { href: `${prefix}#ask`, label: 'Ask me' },
  { href: `${prefix}#work`, label: 'Work' },
  { href: `${prefix}#about`, label: 'About' },
  { href: `${prefix}#contact`, label: 'Contact' },
];

// On phones the links sit on their own row, so they get smaller padding and text to fit
// in one line at 360px wide. min-h-11 keeps each one a 44px touch target.
const linkClass =
  'inline-flex min-h-11 items-center px-3.5 font-medium text-body no-underline hover:text-ink max-md:px-2 max-md:text-[15px]';
---

<header class="border-b border-line bg-white">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-x-4 gap-y-1 px-6 py-3 md:py-[18px]"
  >
    <a
      href={isHome ? '#top' : '/'}
      class="order-1 inline-flex min-h-11 items-center font-heading text-xl font-bold text-ink no-underline hover:text-ink"
    >
      {site.name}
    </a>
    {/* Phones: name + CV button on row 1, links on row 2. From md (768px) up: one row, CV last. */}
    <div
      class="order-3 -mx-2 flex w-full items-center justify-between md:order-2 md:mx-0 md:ml-auto md:w-auto md:justify-start md:gap-2"
    >
      {links.map((link) => (
        <a href={link.href} class={linkClass}>{link.label}</a>
      ))}
    </div>
    <a
      href={site.cvPath}
      class="order-2 rounded-lg bg-ink px-[18px] py-2.5 font-semibold text-white no-underline hover:bg-accent-dark hover:text-white md:order-3"
    >
      Download CV
    </a>
  </nav>
</header>
